{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://futures-radar.local/report/strategy-plan.schema.json",
  "title": "futures-radar strategy-plan.json v1.0",
  "description": "报告「交易策略板块」数据契约（t7）。由 strategy-matcher（t8）产出，t9 渲染、t10/t12 校验。字段定义与 strategies/report-strategy-section.md 一致。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "plans", "provenance", "disclaimer"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "signalDate", "matcherVersion", "rulesVersion", "libraryVersion", "equityCny", "marginRate", "generatedAt", "inputsSha"],
      "properties": {
        "runId": { "type": "string", "minLength": 1, "description": "所属报告运行 ID（与 output/runs/<runId> 一致）" },
        "signalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "信号日 T（报告 meta.signalDate）" },
        "matcherVersion": { "type": "string", "minLength": 1 },
        "rulesVersion": { "type": "string", "minLength": 1, "description": "strategy-matching-rules.json 的 schemaVersion" },
        "libraryVersion": { "type": "string", "minLength": 1, "description": "strategy-library.json 的 schemaVersion" },
        "equityCny": { "type": "number", "exclusiveMinimum": 0, "description": "示例权益口径（默认 100000，非收益承诺）" },
        "marginRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "generatedAt": { "type": "string", "description": "ISO8601 生成时间戳（仅 provenance 用途；确定性校验时忽略）" },
        "inputsSha": { "type": "string", "minLength": 8, "description": "输入 artifacts 的内容哈希（可复现性校验）" }
      }
    },
    "plans": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/definitions/plan" } },
    "concentrationDecisions": {
      "type": "array",
      "items": { "$ref": "#/definitions/concentrationDecision" },
      "description": "集中度仲裁记录；无冲突时为空数组"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generator", "discipline"],
      "properties": {
        "source": { "type": "string", "description": "输入 artifacts 清单（runId 相对路径）" },
        "generator": { "type": "string", "description": "生成器标识，如 futures-radar/strategies/strategy-matcher.cjs" },
        "discipline": {
          "type": "array",
          "items": { "type": "string" },
          "description": "数据纪律声明（无 OI 新增依赖/无前视/无收益承诺）"
        }
      }
    },
    "disclaimer": { "type": "string", "minLength": 20, "description": "固定免责声明，渲染时原样输出" }
  },
  "definitions": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "rank", "sector", "reportBaseline", "matchedStrategies", "supportingEvidence", "playbook", "entry", "stop", "targets", "position", "riskAssessment", "executionStatus", "statusReasons", "invalidation", "notes", "disclaimer"],
      "properties": {
        "symbol": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sector": { "type": "string", "enum": ["black", "nonferrous", "precious", "energy_chemical", "agriculture", "new_materials", "shipping"] },
        "reportBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "confidence", "driver", "confirmSignals", "invalidationConditions"],
          "properties": {
            "direction": { "type": "string", "enum": ["bullish", "bearish", "neutral"], "description": "报告 finalDirection，只读不得修改" },
            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
            "driver": { "type": "string", "description": "Q1 驱动主文本" },
            "confirmSignals": { "type": "array", "items": { "type": "string" }, "description": "Q4 确认信号（原文引用）" },
            "invalidationConditions": { "type": "array", "items": { "type": "string" }, "description": "Q5 失效条件（原文引用）" }
          }
        },
        "matchedStrategies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "队长裁定：每个 TOP3 ≥1 条（score ≥1.5 取前 3）；不足时以 BASE-01 补足一条",
          "items": { "$ref": "#/definitions/matchedStrategy" }
        },
        "supportingEvidence": {
          "type": "array",
          "description": "低于阈值的定性证据命中（evidenceType=qualitative，低权重）",
          "items": { "$ref": "#/definitions/matchedStrategy" }
        },
        "playbook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playbookId", "gateStatus", "gateNote", "executionConvention"],
          "properties": {
            "playbookId": { "type": "string", "pattern": "^PB-0[1-8]$", "not": { "const": "PB-02" }, "description": "PB-02 恒禁用" },
            "gateStatus": { "type": "string", "enum": ["pass", "pending", "fail-open"] },
            "gateNote": { "type": "string", "minLength": 1 },
            "executionConvention": { "type": "string", "description": "T+1 开盘/跳空阈值/停板禁开等执行口径" }
          }
        },
        "entry": { "$ref": "#/definitions/entryPlan" },
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stopPrice", "stopDistancePts", "basis"],
          "properties": {
            "stopPrice": { "type": "number", "exclusiveMinimum": 0 },
            "stopDistancePts": { "type": "number", "exclusiveMinimum": 0 },
            "basis": { "type": "string", "description": "计算依据：min(stopK×ATR5, 0.8×limitPct, |结构位−close|)" }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["t1", "t2", "basis"],
          "properties": {
            "t1": { "type": "string", "description": "T1 目标（R 口径或价格区间），禁止收益数字" },
            "t2": { "type": "string" },
            "basis": { "type": "string" }
          }
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lots", "lotsBasis"],
          "properties": {
            "lots": { "type": "integer", "minimum": 0, "description": "0=watch/skip（仍输出完整适配内容）" },
            "lotsBasis": { "type": "string", "description": "min(风险预算手数, 波动率目标手数, 保证金手数) 各分项数值" }
          }
        },
        "riskAssessment": { "$ref": "#/definitions/riskAssessment" },
        "executionStatus": { "type": "string", "enum": ["executable", "watch", "skip"] },
        "statusReasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "watch/skip 必须给出原因；executable 至少一条（可为风险警示说明）"
        },
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hard", "timeStop", "supersededByNextRun"],
          "properties": {
            "hard": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Q5 失效条件逐条直译" },
            "timeStop": { "type": "string" },
            "supersededByNextRun": { "type": "boolean", "const": true }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "执行注释（事件风险、夜盘、换月提示等）" },
        "disclaimer": { "type": "string", "minLength": 20 }
      }
    },
    "matchedStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyId", "name", "score", "matchEvidence", "evidenceType"],
      "properties": {
        "strategyId": { "type": "string", "pattern": "^(MS|CS|BASE)-" },
        "name": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0 },
        "matchEvidence": { "type": "string", "minLength": 1, "description": "命中字段实值与规则依据（可复算）" },
        "evidenceType": { "type": "string", "enum": ["deterministic", "qualitative"] }
      }
    },
    "entryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "triggerLevel", "triggerSource", "execution"],
      "properties": {
        "trigger": { "type": "string", "description": "入场触发描述（含转执行触发=Q4 确认价位）" },
        "triggerLevel": { "type": ["number", "null"], "description": "Q4 确认价位（正则抽取第一个数字；无法抽取 → null）" },
        "triggerSource": { "type": "string", "description": "Q4 确认信号原文或 playbook trigger" },
        "execution": { "type": "string", "description": "T+1 开盘口径 + 跳空阈值" }
      }
    },
    "riskAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskPerTradePct", "confidenceScale", "stopK", "stopDistancePts", "stopPrice", "structuralStop", "unitRiskCny", "lots", "marginPerLotCny", "marginUtilizationPct", "volContributionPctAnnual", "tailGapPct3d", "stressRiskCny", "eventRiskNote", "maxHoldingDays"],
      "properties": {
        "riskPerTradePct": { "type": "number", "minimum": 0, "maximum": 0.01 },
        "confidenceScale": { "type": "number", "enum": [1.0, 0.75, 0] },
        "stopK": { "type": "number", "minimum": 1.0, "maximum": 2.0 },
        "stopDistancePts": { "type": "number", "exclusiveMinimum": 0 },
        "stopPrice": { "type": "number", "exclusiveMinimum": 0 },
        "structuralStop": { "type": ["number", "null"], "description": "Q5 结构位；未解析到 → null" },
        "unitRiskCny": { "type": "number", "minimum": 0 },
        "lots": { "type": "integer", "minimum": 0 },
        "marginPerLotCny": { "type": "number", "minimum": 0 },
        "marginUtilizationPct": { "type": "number", "minimum": 0 },
        "volContributionPctAnnual": { "type": "number", "minimum": 0 },
        "tailGapPct3d": { "type": "number", "description": "3d p95 反向边距（%），负值=对多头不利/对空头不利按方向口径" },
        "stressRiskCny": { "type": "number", "minimum": 0 },
        "eventRiskNote": { "type": "string" },
        "maxHoldingDays": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "concentrationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflictGroup", "keptSymbol", "downgradedSymbols", "reason"],
      "properties": {
        "conflictGroup": { "type": "string", "description": "如 energy_chemical/bearish 或 同成本锚(SC0)" },
        "keptSymbol": { "type": "string" },
        "downgradedSymbols": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

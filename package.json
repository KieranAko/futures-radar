{
  "name": "futures-radar-skill",
  "version": "2.0.0",
  "description": "该SKILL专注期货投机市场机会发现，提供全期货市场品种扫描→TOP10机会发现→TOP3品种LLM推理分析报告。",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "probe": "node collection/probe-sources.cjs",
    "run": "node pipeline/run.cjs",
    "serve": "node signals/cli/signal-pool-server.cjs",
    "freeze": "node analysis/freeze-packets.mjs",
    "assemble": "node legacy/analyze-v1/assemble-results.mjs",
    "assemble:sector-driver": "node legacy/analyze-v1/assemble-sector-driver.cjs",
    "prefill": "node legacy/analyze-v1/prefill-analysis.cjs",
    "filter:quant": "node legacy/filter/filter/quantitative-filter.cjs --shadow",
    "story:chain": "node stories/cli/story-chain-cli.cjs",
    "macro:history": "node storage/macro-history-builder.cjs --build",
    "story:seats": "node stories/seats/apply-story-seats.cjs",
    "story:link": "node stories/seats/link-signal-pool.cjs",
    "strategy:plan": "node analysis/strategy/build-strategy-plan.cjs --runId",
    "signal:backtest": "node legacy/strategies/signal-backtest/runner.cjs",
    "signal:backtest:v3": "node legacy/strategies/signal-backtest/runner-v3.cjs",
    "signal:backtest:v4": "node legacy/strategies/signal-backtest/runner-v4.cjs",
    "signal:backtest:v5": "node legacy/strategies/signal-backtest/runner-v5.cjs",
    "signal:backtest:v6": "node legacy/strategies/signal-backtest/runner-v6.cjs",
    "signal:backtest:v6-1": "node legacy/strategies/signal-backtest/runner-v6-1.cjs",
    "signal:backtest:v7": "node legacy/strategies/signal-backtest/runner-v7.cjs",
    "signal:backtest:v7:adapt": "node legacy/strategies/signal-backtest/adapters/strategy-plan-adapter.cjs",
    "signal:backtest:v8": "node legacy/strategies/signal-backtest/runner-v8.cjs",
    "signal:backtest:v8-1": "node legacy/strategies/signal-backtest/runner-v8-1.cjs",
    "test": "node --test \"test/*.test.js\" \"legacy/reasoning/reasoning/test/*.test.js\" \"research/experiments/test/*.test.js\" \"research/backtest/test/*.test.cjs\"",
    "test:core": "node --test \"test/*.test.js\"",
    "test:reasoning": "node --test \"legacy/reasoning/reasoning/test/*.test.js\"",
    "install:skill": "node scripts/install.mjs",
    "store:init": "node storage/index.cjs --init",
    "store:seed": "node storage/index.cjs --seed",
    "store:verify": "node storage/index.cjs --verify",
    "store:stats": "node storage/index.cjs --stats",
    "store:export": "node storage/index.cjs --export",
    "store:compact": "node storage/index.cjs --compact",
    "git:check": "node scripts/git-push-policy.cjs --check",
    "git:push": "node scripts/git-push-policy.cjs --push"
  },
  "keywords": [
    "futures",
    "skill",
    "agent",
    "akshare",
    "backtest",
    "china-futures"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
